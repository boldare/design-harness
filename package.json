{
  "name": "atlas-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas base components built from tokens/tokens.json, documented by their tests.",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "lint:tokens": "node scripts/check-raw-values.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run tokens && vitest run",
    "check-states": "node scripts/check-states.mjs",
    "check": "npm run lint:tokens && npm run typecheck && npm test && npm run check-states",
    "dev": "npm run tokens && (vitest & describe-me dev; wait)",
    "docs": "npm test && describe-me build --live --out describe-me-dist",
    "claude-design": "node scripts/build-claude-design.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@describe-me/react": "^0.11.0",
    "@describe-me/vitest": "^0.11.0",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "describe-me": "^0.11.0",
    "playwright": "^1.64.1",
    "typescript": "5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
