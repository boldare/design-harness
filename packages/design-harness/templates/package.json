{
  "type": "module",
  "scripts": {
    "tokens": "design-harness tokens",
    "lint:tokens": "design-harness lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run tokens && vitest run",
    "check-states": "design-harness states",
    "check": "npm run lint:tokens && npm run typecheck && npm test && npm run check-states",
    "dev": "npm run tokens && (vitest & describe-me dev; wait)",
    "docs": "npm test && describe-me build --live --out describe-me-dist"
  },
  "devDependencies": {
    "@describe-me/react": "^0.12.1",
    "@describe-me/vitest": "^0.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "describe-me": "^0.12.1",
    "playwright": "^1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
